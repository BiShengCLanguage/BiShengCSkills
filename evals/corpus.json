{
  "version": 1,
  "notes": "Each prompt is a task a real user would give an AI assistant. reference_test points at the clang/test/BSC Positive test (in the BiShengCLanguage compiler repo) that grounds the feature under test; prompts never copy the test's content. judge=compile means the generated .cbs must be accepted by the BSC compiler (evals/judge.sh). expected_skills lists which skills SHOULD auto-trigger for the prompt (used for the skill-selection metric; a run scores a hit when at least one expected skill fires).",
  "evals": [
    {
      "id": "ownership-ffi-raw-roundtrip-01",
      "feature": "Ownership",
      "prompt": "我有个 C 库,它返回 malloc 出来的裸指针。我想在毕昇C这边把这个裸指针包成带所有权的指针来管理,用完之后再转回裸指针交还给 free。帮我写个能编译的小例子,两个方向的转换都要有。",
      "reference_test": "clang/test/BSC/Positive/Ownership/owned_raw_transfer_builtins/owned_raw_transfer_builtins.cbs",
      "expected_skills": ["bsc-ownership"],
      "judge": "compile"
    },
    {
      "id": "ownership-linked-list-safezone-02",
      "feature": "Ownership",
      "prompt": "用毕昇C写一个单链表:节点内存用带所有权的指针管理,next 允许为空,插入新节点时所有权要转移进链表,释放时不许直接用裸指针 free。尽量把逻辑放在安全区里。",
      "reference_test": "clang/test/BSC/Positive/Ownership/self_referential_owned_pointer/self_referential_owned_pointer.cbs",
      "expected_skills": ["bsc-ownership", "bsc-safe-zone"],
      "judge": "compile"
    },
    {
